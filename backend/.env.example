# Copy to .env. Never commit secrets. Empty values are not configured.
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_CHAT_MODEL_1=
# Optional reranker; missing/failed model 2 falls back to merged RRF order.
GEMINI_CHAT_MODEL_2=
GEMINI_EMBEDDING_MODEL=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Personal Google Drive OAuth client JSON file path.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_TOKEN_FILE=credentials/token.json
# Administrator login. Run: .venv/bin/python -m app.auth --set-password
# AUTH_SECRET must contain at least 32 random characters.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
# Separate FastMCP retrieval server used by the conversation client.
MCP_RETRIEVAL_URL=http://127.0.0.1:8001/mcp
