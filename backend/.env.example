# Copy to .env. Never commit secrets. Empty values are not configured.
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_CHAT_MODEL_1=
GEMINI_EMBEDDING_MODEL=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Personal Google Drive OAuth client JSON file path.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_TOKEN_FILE=credentials/token.json
# Reserved for Step 3; not required for connection checks.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
